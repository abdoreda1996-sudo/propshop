# Production environment. Copy to your host's secret store — never commit a filled copy.
#
# /api/health reports "degraded" and names anything missing, so a misconfigured deploy is
# visible rather than silent.

# --- Database -----------------------------------------------------------------
# Postgres, NOT SQLite. SQLite allows one writer for the whole file; measured at 20k
# listings and 200 concurrent operations it reached a p95 of 7 seconds. See SCALING.md.
DATABASE_URL="postgresql://user:pass@pooler-host:6543/aqarsale?pgbouncer=true&connection_limit=20"
# Direct connection, bypassing the pooler. Migrations need it; the app does not use it.
DIRECT_DATABASE_URL="postgresql://user:pass@db-host:5432/aqarsale"

# --- Cache and rate limiting ---------------------------------------------------
# Without this, rate limits are PER PROCESS: N instances allow N x the limit, and OTP
# becomes an SMS bill and an abuse vector.
REDIS_URL="rediss://default:pass@redis-host:6379"

# --- Object storage ------------------------------------------------------------
# ~650 GB in month one. Cloudflare R2 recommended: this workload is egress-heavy and R2
# has no egress charge. All three of endpoint/key/secret are required together.
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_PRIVATE="aqar-private"   # originals + ownership documents. NEVER public.
S3_BUCKET_PUBLIC="aqar-public"     # derived, watermarked renditions only
CDN_BASE_URL="https://cdn.aqarsale.com"

# --- Secrets -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""
NATIONAL_ID_PEPPER=""

# --- Scheduled jobs ------------------------------------------------------------
# POST /api/jobs?job=frequent  every 5 minutes
# POST /api/jobs?job=nightly   once a day
# with header: x-job-secret: $JOB_SECRET
# The endpoint fails CLOSED if this is unset.
JOB_SECRET=""

# --- Integrations --------------------------------------------------------------
ANTHROPIC_API_KEY=""     # ownership-document extraction; stubs out when unset
# SMS gateway for OTP delivery — still unimplemented. No real user can sign in without it.
# SMS_PROVIDER=""
# SMS_API_KEY=""

NEXT_PUBLIC_SITE_URL="https://aqarsale.com"
NODE_ENV="production"

# The WhatsApp intake line shown on /list — digits only, country code, no leading "+".
# Example: 201001234567
# Leave unset and the WhatsApp box renders disabled with an explanatory note rather than a
# dead wa.me link.
NEXT_PUBLIC_WHATSAPP_NUMBER=
